<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="release|x64">
      <Configuration>release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="release|Win32">
      <Configuration>release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="release|ARM64">
      <Configuration>release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{3C1F4E7A-9B62-4D58-8E44-2A7D6C5B10F3}</ProjectGuid>
    <CharacterSet>Unicode</CharacterSet>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <RootNamespace>tests</RootNamespace>
    <ProjectName>tests</ProjectName>
    <TargetName>tests</TargetName>
    <GenerateManifest>false</GenerateManifest>
    <Arch>$(Platform.ToLower().Replace('win32', 'x86'))</Arch>
    <OutDir>$(SolutionDir)bin\$(Arch)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration.ToLower())\$(Arch)\</IntDir>
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="Shared">
    <Import Project="$(SolutionDir)shared\shared.vcxitems" Label="Shared" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <IncludePath>$(SolutionDir)dll\src;$(SolutionDir)dll\src\include;$(SolutionDir)shared;$(IncludePath)</IncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <TreatWarningAsError>true</TreatWarningAsError>
	  <PreprocessorDefinitions>SHELLEXT_CAPTURE_TESTING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- The test sources carry non-ASCII literals on purpose. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>shlwapi.lib;ole32.lib;oleaut32.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
	<None Include="fixtures\native_moveto_nested.nss" />
    <ClInclude Include="test.h" />
    <ClInclude Include="..\shared\System\Text\StringCompare.h" />
    <ClInclude Include="..\dll\src\Include\BitmapCache.h" />
    <ClInclude Include="..\dll\src\Include\MenuText.h" />
    <ClInclude Include="..\dll\src\Include\NativeMenuLazy.h" />
    <ClInclude Include="..\dll\src\Include\ExplorerCommandCatalog.h" />
    <ClInclude Include="..\dll\src\Include\OneShotMarshal.h" />
    <ClInclude Include="..\dll\src\Include\Packages.h" />
    <ClInclude Include="..\dll\src\Include\TaskbarHitCache.h" />
    <ClInclude Include="..\dll\src\Include\TaskbarOrigin.h" />
	<ClInclude Include="..\dll\src\Expression\SelectionPathResolver.h" />
	<ClInclude Include="..\shared\LegacyConfigTransfer.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="test_stringcompare.cpp" />
    <ClCompile Include="test_string_search.cpp" />
    <ClCompile Include="test_encoding.cpp" />
    <ClCompile Include="test_bitmapcache.cpp" />
    <ClCompile Include="test_wic.cpp" />
    <ClCompile Include="test_shellext.cpp" />
    <ClCompile Include="test_selection_path_resolver.cpp" />
    <ClCompile Include="test_threadsafety.cpp" />
    <ClCompile Include="test_parser.cpp" />
    <ClCompile Include="test_native_menu_lazy.cpp" />
    <ClCompile Include="test_explorer_command.cpp" />
    <ClCompile Include="test_packages.cpp" />
    <ClCompile Include="test_taskbar_cache.cpp" />
    <ClCompile Include="test_menutext.cpp" />
    <ClCompile Include="test_registry.cpp" />
    <ClCompile Include="test_regop.cpp" />
    <ClCompile Include="test_fso.cpp" />
    <ClCompile Include="test_manifest.cpp" />
    <ClCompile Include="test_path.cpp" />
    <ClCompile Include="test_taskbar_origin.cpp" />
    <ClCompile Include="test_path_bounds.cpp" />
    <ClCompile Include="test_comptr.cpp" />
    <ClCompile Include="test_window_text.cpp" />
    <ClCompile Include="test_dll_load.cpp" />
	<ClCompile Include="test_legacy_config_transfer.cpp" />
    <ClCompile Include="test_treatas_plan.cpp" />
    <ClCompile Include="test_oneshot_marshal.cpp" />
    <ClCompile Include="test_loadstring.cpp" />
    <ClCompile Include="..\dll\src\Packages.cpp" />
    <ClCompile Include="..\dll\src\ShellExt.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="tests.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Run the suite as part of the build so a regression fails CI, not just a
       later manual step. Cross-compiled binaries cannot run on the host. -->
  <Target Name="RunTests" AfterTargets="Build" Condition="'$(Platform)'=='x64' AND '$(RunTestsAfterBuild)'!='false'">
    <Exec Command="&quot;$(TargetPath)&quot;" WorkingDirectory="$(OutDir)" />
  </Target>
</Project>
