  <!-- The shipping expression engine, linked into the test binary so expression
       tests exercise the real evaluator instead of a copy of it. The closure is
       small and was established by linking it standalone: Scope/Context/Expression/
       Array/Operator/Func plus Selections and MenuPerf, on top of Packages.cpp,
       Log.cpp and Registry.cpp which the suite already builds.
       These translation units keep the DLL project's own compile policy (its
       macros, and Level4 warnings that are not errors there); the test sources
       themselves stay on /WX. -->
  <ItemGroup>
    <ClCompile Include="..\dll\src\Expression\Scope.cpp" />
    <ClCompile Include="..\dll\src\Expression\Context.cpp" />
    <ClCompile Include="..\dll\src\Expression\Expression.cpp" />
    <ClCompile Include="..\dll\src\Expression\ArrayExpression.cpp" />
    <ClCompile Include="..\dll\src\Expression\OperatorExpression.cpp" />
    <ClCompile Include="..\dll\src\Expression\FuncExpression.cpp" />
    <ClCompile Include="..\dll\src\Selections.cpp" />
    <ClCompile Include="..\dll\src\MenuPerf.cpp" />
    <ClCompile Include="..\dll\src\DiagnosticsRing.cpp" />
    <ClCompile Include="..\dll\src\Parser\Lexer.cpp" />
    <ClCompile Include="..\dll\src\Parser\Parser.cpp" />
    <ClCompile Include="..\dll\src\Parser\Properties.cpp" />
    <ClCompile Include="..\dll\src\Parser\Verification.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Update="..\dll\src\Expression\*.cpp;..\dll\src\Parser\*.cpp;..\dll\src\Selections.cpp;..\dll\src\MenuPerf.cpp;..\dll\src\DiagnosticsRing.cpp">
      <!-- IDD_INPUTBOX and friends in shared\Resource.h sit behind _WINDLL, and
           FuncExpression.cpp's input() implementation needs them. -->
      <PreprocessorDefinitions>_WINDOWS;_WINDLL;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="tests.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Run the suite as part of the build so a regression fails CI, not just a
       later manual step. Cross-compiled binaries cannot run on the host. -->
  <Target Name="RunTests" AfterTargets="Build" Condition="'$(Platform)'=='x64' AND '$(RunTestsAfterBuild)'!='false'">
    <Exec Command="&quot;$(TargetPath)&quot;" WorkingDirectory="$(OutDir)" />
  </Target>
</Project>
