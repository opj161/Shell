  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <IncludePath>$(SolutionDir)dll\src;$(SolutionDir)dll\src\include;$(SolutionDir)shared;$(IncludePath)</IncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- Match Shell.vcxproj (line 69) and exe.vcxproj: x86 builds default to
           __stdcall. It is invisible on x64/ARM64, which have one convention, but
           on x86 the prebuilt plutosvg-x86.lib is stdcall-decorated
           (_plutovg_surface_destroy@4) and the DLL translation units linked in
           below must be compiled the same way the DLL compiles them. Leaving this
           at the cdecl default links on x64 and fails only on x86. -->
      <CallingConvention Condition="'$(Platform)'=='Win32'">StdCall</CallingConvention>
	  <PreprocessorDefinitions>SHELLEXT_CAPTURE_TESTING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- The test sources carry non-ASCII literals on purpose. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- plutosvg is pulled in by Context.cpp's image path; the rest are the
           system libraries the expression engine's own translation units use.
           The prebuilt libraries are named by architecture, not by MSBuild
           platform, so this uses $(Arch) - $(Platform) is "Win32" where the
           library is "x86", exactly as Main.cpp's own arch-guarded pragmas have it. -->
      <AdditionalDependencies>shlwapi.lib;ole32.lib;oleaut32.lib;bcrypt.lib;comctl32.lib;windowscodecs.lib;dwmapi.lib;uxtheme.lib;version.lib;propsys.lib;$(SolutionDir)shared\Library\plutosvg-$(Arch).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
