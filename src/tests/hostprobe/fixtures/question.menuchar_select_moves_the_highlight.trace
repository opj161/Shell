WM_ENTERMENULOOP
WM_INITMENU          menu=menu#1
WM_INITMENUPOPUP     menu=menu#1 position=0 windowmenu=0
WM_MENUCHAR          char=90 type=POPUP menu=menu#1 hilite=-1  -> 0x00030003
WM_MENUSELECT        item=5004 flags=HILITE|MOUSESELECT menu=menu#1
WM_UNINITMENUPOPUP   menu=menu#1 sysmenu=0
WM_MENUSELECT        item=0 flags=CLOSED menu=null
WM_EXITMENULOOP
= returned 0, lasterror none, ownerdrawn not drawn
