
<?include version.wxi ?>
<?include identity.wxi ?>

<?define UpgradeCode = '{7BCA6512-254B-456F-8F08-AAD7508BEE00}' ?>
<?define Name = 'Shell' ?>
<?define Manufacturer = 'Nilesoft' ?>
<?define FullName = '$(var.Manufacturer) $(var.Name)' ?>
<?define Info = 'Powerful context menu manager for Windows File Explorer' ?>
<?define bin = '..\..\bin' ?>
<!--
	sys.BUILDARCH rather than a local Platform variable: MSBuild already passes
	Platform, spelled with the solution's casing ('ARM64'), so redefining it here
	from sys.BUILDARCH ('arm64') is a WIX1118 collision. identity.wxi keys off
	sys.BUILDARCH too, so everything now reads the same value.
-->
<?define arch_bin = '..\..\bin\$(sys.BUILDARCH)' ?>
<?define PlatformProgramFilesFolder = 'ProgramFiles6432Folder' ?>

<!--
<?if $(sys.BUILDARCH) = x64 ?>
	<?define PlatformProgramFilesFolder = 'ProgramFiles64Folder' ?>
<?elseif $(sys.BUILDARCH) = arm64 ?>
	<?define PlatformProgramFilesFolder = 'ProgramFiles64Folder' ?>
<?else ?>
	<?define PlatformProgramFilesFolder = 'ProgramFilesFolder' ?>
<?endif ?>
-->

<Wix xmlns='http://wixtoolset.org/schemas/v4/wxs'>
	<Package
		Language='1033'
		Codepage='65001'
		InstallerVersion='500'
		Compressed='yes'
		Scope='perMachine'
		ProductCode='$(var.ProductCode)'
		UpgradeCode='$(var.UpgradeCode)'
		Manufacturer='$(var.Manufacturer)'
		Name='$(var.FullName)'
		Version='$(var.Version)'>

		<SummaryInformation
			Comments='$(var.FullName)'
			Description='$(var.FullName) $(var.Version) $(sys.BUILDARCH) Setup'
			Keywords='context-menu, right-click, file-explorer' />

		<Media Id='1' EmbedCab='yes' Cabinet='main.cab' CompressionLevel='high' />

		<Binary Id='WixUI_Banner' SourceFile='res\WixUI_Banner.png' />
		<Binary Id='WixUI_Dialog' SourceFile='res\WixUI_Dialog.png' />
		<Binary Id='WixUI_Bmp_Up' SourceFile='res\WixUI_Bmp_Up.bmp' />
		<Binary Id='WixUI_Bmp_New' SourceFile='res\WixUI_Bmp_New.bmp' />
		<Binary Id='WixUI_Ico_Exclam' SourceFile='res\WixUI_Ico_Exclam.ico' />
		<Binary Id='WixUI_Ico_Info' SourceFile='res\WixUI_Ico_Info.ico' />
		<Binary Id='CA' SourceFile='$(var.arch_bin)\ca.dll' />

		<Property Id='WIXUI_INSTALLDIR' Value='INSTALLFOLDER' />
		<Property Id='WixUIRMOption' Value='UseRM' />
		<Property Id='DefaultUIFont' Value='WixUI_Font_Normal' />
		<Property Id='ErrorDialog' Value='ErrorDlg' />
		<Property Id='ARPURLINFOABOUT' Value='https://nilesoft.org/' />
		<Property Id='ARPHELPLINK' Value='https://nilesoft.org/docs/' />
		<Property Id='ARPNOMODIFY' Value='1' Secure='yes' />
		<Property Id='ARPNOREPAIR' Value='1' Secure='yes' />
		<Property Id='BURNMSIMODIFY' Value='0' Secure='yes' />
		<Property Id='BURNMSIREPAIR' Value='0' Secure='yes' />
		<Property Id='BURNMSIUNINSTALL' Value='1' Secure='yes' />
		
		<StandardDirectory Id='$(var.PlatformProgramFilesFolder)'>
			<Directory Id='INSTALLFOLDER' Name='$(var.FullName)'>
				<Directory Id='IMPORTS' Name='imports'>
					<Component Id='IMPORTS' Guid='$(var.ImportsComponentGuid)'>
						<File Id='theme.nss' Source='$(var.bin)\imports\theme.nss' />
						<File Id='goto.nss' KeyPath='yes' Source='$(var.bin)\imports\goto.nss' />
						<File Id='modify.nss' Source='$(var.bin)\imports\modify.nss' />
						<File Id='images.nss' Source='$(var.bin)\imports\images.nss' />
						<File Id='taskbar.nss' Source='$(var.bin)\imports\taskbar.nss' />
						<File Id='develop.nss' Source='$(var.bin)\imports\develop.nss' />
						<File Id='file_manage.nss' Source='$(var.bin)\imports\file-manage.nss' />
						<File Id='terminal.nss' Source='$(var.bin)\imports\terminal.nss' />
					</Component>
				<Directory Id='LANG' Name='lang'>
					<Component Id='LANG' Guid='$(var.LangComponentGuid)'>
						<File Id='en.nss' Source='$(var.bin)\imports\lang\en.nss' />
						<File Id='ar.nss' Source='$(var.bin)\imports\lang\ar.nss' />
						<File Id='de_DE.nss' Source='$(var.bin)\imports\lang\de-DE.nss' />
						<File Id='ko.nss' Source='$(var.bin)\imports\lang\ko.nss' />
						<File Id='no.nss' Source='$(var.bin)\imports\lang\no.nss' />
						<File Id='nb.nss' Source='$(var.bin)\imports\lang\nb.nss' />
						<File Id='pt_BR.nss' Source='$(var.bin)\imports\lang\pt-BR.nss' />
						<File Id='zh_CN.nss' Source='$(var.bin)\imports\lang\zh-CN.nss' />
					</Component>
					<!-- These translations were in the tree but not in any component,
					     so they shipped to nobody. Kept in a separate component from
					     LANG so the original one's file list stays stable across
					     upgrades. Any new locale goes here. -->
					<Component Id='LANG2' Guid='$(var.Lang2ComponentGuid)'>
						<File Id='es_ES.nss' KeyPath='yes' Source='$(var.bin)\imports\lang\es-ES.nss' />
						<File Id='it.nss' Source='$(var.bin)\imports\lang\it.nss' />
						<File Id='ja.nss' Source='$(var.bin)\imports\lang\ja.nss' />
						<File Id='ro.nss' Source='$(var.bin)\imports\lang\ro.nss' />
						<File Id='ru.nss' Source='$(var.bin)\imports\lang\ru.nss' />
						<File Id='sl.nss' Source='$(var.bin)\imports\lang\sl.nss' />
						<File Id='tr.nss' Source='$(var.bin)\imports\lang\tr.nss' />
						<File Id='ua.nss' Source='$(var.bin)\imports\lang\ua.nss' />
						<File Id='uk.nss' Source='$(var.bin)\imports\lang\uk.nss' />
						<File Id='zh_TW.nss' Source='$(var.bin)\imports\lang\zh-TW.nss' />
					</Component>
				</Directory>
				</Directory>
				<!-- Architecture-specific component code and bitness; see identity.wxi. -->
				<Component Id='APPLICATION' Guid='$(var.ApplicationComponentGuid)' Bitness='$(var.ComponentBitness)'>
					<CreateFolder Directory='INSTALLFOLDER' />
					<File Id='shell.exe' Checksum='yes' Name='shell.exe' KeyPath='yes' Source='$(var.arch_bin)\shell.exe' />
					<File Id='shell.dll' Checksum='yes' Name='shell.dll' Source='$(var.arch_bin)\shell.dll' />
					<File Id='readme.txt' Name='readme.txt' Source='$(var.bin)\readme.txt' />
					<File Id='license.txt' Name='LICENSE' Source='$(var.bin)\license.txt' />
				</Component>
				<!--
					Windows Installer owns Shell's registration so install, repair, rollback,
					upgrade, and uninstall all operate on the same declared resources. The
					registry value is the explicit key path; do not let child ordering choose it.

					  .bin/wix-docs/schema/wxs/component.mdx
					  .bin/wix-docs/schema/wxs/registryvalue.mdx
					  https://learn.microsoft.com/windows/win32/msi/selfreg-table
					  https://learn.microsoft.com/windows/win32/msi/registry-table
				-->
				<Component Id='REGISTRATION' Guid='$(var.RegistrationComponentGuid)' Bitness='$(var.ComponentBitness)'>
					<RegistryValue Id='ContextClassName' Root='HKCR'
						Key='CLSID\{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}'
						Type='string' Value='Nilesoft.Shell' KeyPath='yes' />
					<!--
						A Registry row cannot use [#shell.dll] across components: ICE69
						requires a file reference to belong to the row's own component.
						Use this registry-only component's target directory instead.
						https://learn.microsoft.com/windows/win32/msi/ice69
					-->
					<RegistryValue Id='ContextServer' Root='HKCR'
						Key='CLSID\{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}\InprocServer32'
						Type='string' Value='[$REGISTRATION]shell.dll' />
					<RegistryValue Id='ContextThreadingModel' Root='HKCR'
						Key='CLSID\{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}\InprocServer32'
						Name='ThreadingModel' Type='string' Value='Apartment' />
					<RegistryValue Id='ApprovedContextHandler' Root='HKLM'
						Key='SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved'
						Name='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' Type='string'
						Value='&#x20;@nilesoft.shell' />

					<RegistryValue Id='ContextHandlerFiles' Root='HKCR'
						Key='*\shellex\ContextMenuHandlers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' />
					<RegistryValue Id='ContextHandlerDirectory' Root='HKCR'
						Key='Directory\shellex\ContextMenuHandlers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' />
					<RegistryValue Id='ContextHandlerDrive' Root='HKCR'
						Key='Drive\shellex\ContextMenuHandlers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' />
					<RegistryValue Id='ContextHandlerFolder' Root='HKCR'
						Key='Folder\shellex\ContextMenuHandlers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' />
					<RegistryValue Id='ContextHandlerDirectoryBackground' Root='HKCR'
						Key='Directory\Background\shellex\ContextMenuHandlers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' />
					<RegistryValue Id='ContextHandlerDesktopBackground' Root='HKCR'
						Key='DesktopBackground\shellex\ContextMenuHandlers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' />
					<RegistryValue Id='ContextHandlerLibraryFolder' Root='HKCR'
						Key='LibraryFolder\shellex\ContextMenuHandlers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' />
					<RegistryValue Id='ContextHandlerLibraryBackground' Root='HKCR'
						Key='LibraryFolder\Background\shellex\ContextMenuHandlers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF1}' />

					<RegistryValue Id='OverlayClassName' Root='HKCR'
						Key='CLSID\{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF2}'
						Type='string' Value='Nilesoft.Shell' />
					<RegistryValue Id='OverlayServer' Root='HKCR'
						Key='CLSID\{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF2}\InprocServer32'
						Type='string' Value='[$REGISTRATION]shell.dll' />
					<RegistryValue Id='OverlayThreadingModel' Root='HKCR'
						Key='CLSID\{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF2}\InprocServer32'
						Name='ThreadingModel' Type='string' Value='Apartment' />
					<RegistryValue Id='OverlayIdentifier' Root='HKLM'
						Key='SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\&#x20;@nilesoft.shell'
						Type='string' Value='{BAE3934B-8A6A-4BFB-81BD-3FC599A1BAF2}' />

					<RegistryValue Id='NssContentType' Root='HKCR' Key='.nss'
						Name='Content Type' Type='string' Value='text/plain' />
					<RegistryValue Id='NssOpenCommand' Root='HKCR' Key='.nss\shell\open\command'
						Type='string' Value='notepad &quot;%1&quot;' />
				</Component>
				<!--
					shell.nss is the user's own file, and three separate mechanisms keep
					it that way, in order of how much has to work.

					Permanent: the removal half of a major upgrade does not take it, so a
					1.9.20-or-later upgrade never reaches the problem at all. The cost is
					that a genuine uninstall leaves the file behind - the right way round
					for a file the user wrote.

					The documented file rule: shell.nss is unversioned, and "if the
					Modified date is later than the Create date for the file on the
					computer, do not install the file because user customizations would be
					deleted". That test is applied at InstallFiles, against what is on disk
					by then. An untouched config still gets refreshed with the new
					defaults, which is what should happen.

					  https://learn.microsoft.com/en-us/windows/win32/msi/file-versioning-rules

					And the custom action pair, for the one case neither covers: upgrading
					from a package built before Permanent was set, whose own uninstall
					logic governs during the removal.

					NeverOverwrite is deliberately *not* set. It resolves the component to
					"install nothing" during costing, which is before
					RemoveExistingProducts deletes the old product's copy - so the two
					cancelled out and the config vanished, proven in an upgrade log. It is
					also documented for components "being registered by the Registry
					table", which this is not. Without it, the worst case is the stock
					config rather than no config.

					  https://learn.microsoft.com/en-us/windows/win32/msi/component-table
				-->
				<Component Id='CONFIG' Guid='$(var.ConfigComponentGuid)' Permanent='yes'>
					<File Id='shell.nss' Name='shell.nss' KeyPath='yes' Source='$(var.bin)\shell.nss' />
				</Component>
				<!--
					Targeted patterns, not '*.*'. A bare wildcard here removes everything
					in the directory whenever this component is removed, and during a
					major upgrade the component being removed belongs to the *old*
					product - so the purge could take the new product's freshly installed
					binaries with it. Windows Installer removes the files it installed on
					its own; this only has to cover what Shell and the custom action
					create at run time.

					The '.old.*' patterns are the rotated copies of a shell.dll that was
					still mapped when a previous install needed its path. Each carries a
					timestamp, so a fixed name cannot match them - and RemoveFile's
					FileName column is a WildCardFilename, where "all of the files that
					match the wildcard will be removed from the specified directory".

					  https://learn.microsoft.com/en-us/windows/win32/msi/removefile-table

					WiX pairs each of those with a generated 8.3 short name, because the
					pattern is not one - the emitted FileName reads '8elsxnvg.old|shell.dll.old*'.
					Windows Installer uses the long half unless SHORTFILENAMES is set, and
					the generated half is a literal that matches nothing, so the worst it
					can do is remove no files.
				-->
				<Component Id='CLEANUP' Guid='$(var.CleanupComponentGuid)' KeyPath='yes'>
					<RemoveFile Id='PurgeLog' Name='shell.log' On='uninstall' Directory='INSTALLFOLDER' />
					<RemoveFile Id='PurgeStockConfig' Name='shell.nss.stock-new' On='uninstall' Directory='INSTALLFOLDER' />
					<RemoveFile Id='PurgeDllOld' Name='shell.dll.old*' On='both' Directory='INSTALLFOLDER' />
					<RemoveFile Id='PurgeExeRotated' Name='shell.exe.old*' On='both' Directory='INSTALLFOLDER' />
					<RemoveFile Id='PurgeExeOld' Name='shell.old' On='both' Directory='INSTALLFOLDER' />
					<RemoveFolder Id='PurgeAppFolder' On='uninstall' Directory='INSTALLFOLDER' />
				</Component>
				<Component Id='DisplayIcon' Guid='$(var.DisplayIconComponentGuid)'>
					<RegistryValue Id='DisplayIcon' Key='SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]'
						Name='DisplayIcon' Root='HKLM' Type='string' Value='[!shell.exe]' KeyPath='yes'/>
				</Component>
			</Directory>
		</StandardDirectory>
		<StandardDirectory Id='ProgramMenuFolder'>
			<Component Id='StartMenuShortcut' Guid='$(var.StartMenuShortcutComponentGuid)'>
				<Shortcut Id='StartMenuShortcut' Directory='ProgramMenuFolder' Description='$(var.Info)'
					WorkingDirectory='INSTALLFOLDER' Name='$(var.FullName)' Target='[!shell.exe]' />
				<RegistryValue Key='Software\Nilesoft\Shell' Root='HKCU' Type='string' Value='' KeyPath='yes' />
			</Component>
		</StandardDirectory>
<!--
		<ComponentGroup Id="IMPORTFiles" Directory="IMPORTS">
			<Files Include="$(var.bin)\imports\*.nss" />
		</ComponentGroup>
-->
		<Feature Id='APPLICATION' Title='$(var.FullName)' Level='1'>
			<ComponentRef Id='APPLICATION' />
			<ComponentRef Id='REGISTRATION' />
			<ComponentRef Id='CONFIG' />
			<ComponentRef Id='IMPORTS' />
			<ComponentRef Id='LANG' />
			<ComponentRef Id='LANG2' />
			<ComponentRef Id='CLEANUP' />
			<ComponentRef Id='StartMenuShortcut' />
			<ComponentRef Id='DisplayIcon' />
			<!--<ComponentGroupRef Id="IMPORTSFiles"/>-->
		</Feature>
		
		<!-- Upgrade -->
		<Property Id='NEWPRODUCTFOUND' Secure='yes' />
		<Property Id='UPGRADEFOUND' Secure='yes' />
		<Property Id='LEGACYCONFIGUPGRADE' Secure='yes' />
		
		<!--
			NEWPRODUCTFOUND is VersionMinInclusive + OnlyDetect at $(var.Version),
			so it fires for the same version as well as a newer one - and the same
			version under this UpgradeCode is how the other architecture presents
			itself. Saying "a newer version" sends anyone who hits that case
			looking for a version they have not got.
		-->
		<CustomAction Id='OnDowngrading' Error='This or a newer version of [ProductName] is already installed, possibly for a different architecture. Uninstall it first, then run this installer again.' />
		
		<Upgrade Id='$(var.UpgradeCode)'>
			<UpgradeVersion Property='NEWPRODUCTFOUND' Minimum='$(var.Version)' OnlyDetect='yes' />
			<UpgradeVersion Property='UPGRADEFOUND' Minimum='1.0.0' Maximum='$(var.Version)' IncludeMinimum='yes' />
			<!-- The config bridge is only for packages before CONFIG became permanent. -->
			<UpgradeVersion Property='LEGACYCONFIGUPGRADE' Minimum='1.0.0' Maximum='1.9.20'
				IncludeMinimum='yes' IncludeMaximum='no' OnlyDetect='yes' />
		</Upgrade>
		
		<InstallUISequence>
			<Custom Action='OnDowngrading' After='FindRelatedProducts' Condition='NEWPRODUCTFOUND' />
		</InstallUISequence>
		<!-- End Upgrade -->
		
		<!--
			Only a pre-1.9.20 upgrade needs config rescue: CONFIG has been permanent
			since 1.9.20. The checked immediate action snapshots the outgoing file to
			a CREATE_NEW random path and binds it to a SHA-256 digest. The deferred
			SYSTEM action accepts bytes only from the same non-reparse handle after
			recomputing that digest. Rollback restores the new stock file; commit
			removes the transaction-unique staging files.

			  .bin/wix-docs/schema/wxs/upgradeversion.mdx
			  .bin/wix-docs/schema/wxs/customaction.mdx
			  https://learn.microsoft.com/windows/win32/msi/installing-permanent-components-files-fonts-registry-keys
			  https://learn.microsoft.com/windows/win32/msi/rollback-custom-actions
			  https://learn.microsoft.com/windows/win32/api/fileapi/nf-fileapi-createfilew
			  https://learn.microsoft.com/windows/win32/api/winbase/nf-winbase-getfileinformationbyhandleex
		-->
		<CustomAction Id='BackupLegacyConfig' Return='check' BinaryRef='CA' DllEntry='BackupLegacyConfig' />
		<CustomAction Id='RestoreLegacyConfigRollback' Execute='rollback' Impersonate='no'
			Return='check' HideTarget='yes' BinaryRef='CA' DllEntry='RestoreLegacyConfigRollback' />
		<CustomAction Id='RestoreLegacyConfig' Execute='deferred' Impersonate='no'
			Return='check' HideTarget='yes' BinaryRef='CA' DllEntry='RestoreLegacyConfig' />
		<CustomAction Id='CleanupLegacyConfig' Execute='commit' Impersonate='no'
			Return='ignore' HideTarget='yes' BinaryRef='CA' DllEntry='CleanupLegacyConfig' />
		<!--
			The Windows 11 primary-menu redirect is the sole protected registry
			exception. Preparation is read-only; the checked deferred action and its
			preceding rollback action receive only the absent/ours/foreign plan via
			CustomActionData. Both use explicit HKLM and the 64-bit registry view.

			  .bin/wix-docs/schema/wxs/customaction.mdx
			  https://learn.microsoft.com/windows/win32/com/treatas
			  https://learn.microsoft.com/windows/win32/sysinfo/merged-view-of-hkey-classes-root
			  https://learn.microsoft.com/windows/win32/msi/rollback-custom-actions
		-->
		<CustomAction Id='PrepareTreatAs' Return='check' BinaryRef='CA' DllEntry='PrepareTreatAs' />
		<CustomAction Id='TreatAsRollback' Execute='rollback' Impersonate='no' Return='check'
					  HideTarget='yes' BinaryRef='CA' DllEntry='TreatAsRollback' />
		<CustomAction Id='TreatAsApply' Execute='deferred' Impersonate='no' Return='check'
					  HideTarget='yes' BinaryRef='CA' DllEntry='TreatAsApply' />
		<!--
			Registration is declarative above. Notify the Shell after the MSI
			transaction commits; SHCNE_ASSOCCHANGED requires SHCNF_IDLIST and null
			items. The notification is advisory, so it cannot invalidate a completed
			install if a recipient misbehaves.

			  https://learn.microsoft.com/windows/win32/api/shlobj_core/nf-shlobj_core-shchangenotify
		-->
		<CustomAction Id='NotifyShellChanged' Return='ignore' BinaryRef='CA' DllEntry='NotifyShellChanged' />
		
		<InstallExecuteSequence>
			<Custom Action='OnDowngrading' After='FindRelatedProducts' Condition='NEWPRODUCTFOUND' />
			<Custom Action='BackupLegacyConfig' After='CostFinalize'
				Condition='(NOT Installed) AND (NOT REMOVE) AND UPGRADEFOUND AND LEGACYCONFIGUPGRADE' />
			<Custom Action='PrepareTreatAs' After='InstallValidate'
					Condition='VersionNT64 AND (WindowsBuild &gt;= 22000) AND (((NOT Installed) AND (NOT REMOVE)) OR ((REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)))' />
			<Custom Action='RestoreLegacyConfigRollback' After='InstallFiles'
				Condition='(NOT Installed) AND (NOT REMOVE) AND UPGRADEFOUND AND LEGACYCONFIGUPGRADE' />
			<Custom Action='RestoreLegacyConfig' After='RestoreLegacyConfigRollback'
				Condition='(NOT Installed) AND (NOT REMOVE) AND UPGRADEFOUND AND LEGACYCONFIGUPGRADE' />
			<Custom Action='CleanupLegacyConfig' After='RestoreLegacyConfig'
				Condition='(NOT Installed) AND (NOT REMOVE) AND UPGRADEFOUND AND LEGACYCONFIGUPGRADE' />
			<Custom Action='TreatAsRollback' After='WriteRegistryValues'
					Condition='VersionNT64 AND (WindowsBuild &gt;= 22000) AND (((NOT Installed) AND (NOT REMOVE)) OR ((REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)))' />
			<Custom Action='TreatAsApply' After='TreatAsRollback'
					Condition='VersionNT64 AND (WindowsBuild &gt;= 22000) AND (((NOT Installed) AND (NOT REMOVE)) OR ((REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)))' />
			<Custom Action='NotifyShellChanged' After='InstallFinalize' />
			<!--
				The old product is removed entirely before the new one is installed. It
				now runs immediately after InstallInitialize, before any script-generating
				action, so failure of the new install rolls the old product removal back.

				This has to move together with the architecture-specific component
				codes above: with a different code, the old APPLICATION component is
				no longer the same component as the new one, so it is not reference
				counted against it. Removing the old product after InstallFinalize
				would therefore delete shell.exe and shell.dll from the directory the
				new product had just written them to.

				  .bin/wix-docs/schema/wxs/majorupgrade.mdx
				  https://learn.microsoft.com/windows/win32/msi/removeexistingproducts-action
			-->
			<RemoveExistingProducts After='InstallInitialize' />
		</InstallExecuteSequence>

		<?include ui.wxi ?>
	</Package>
</Wix>
