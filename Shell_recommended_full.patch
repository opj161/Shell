+    # Follow-up: retarget the projects off v143 so the runner image can float
+    # again. Until then this is pinned deliberately, not by neglect.
+    runs-on: windows-2022
 
     strategy:
+      fail-fast: false
       matrix:
-        # configuration: [debug, release]
-        configuration: [release]
         platform: [x64, x86, arm64]
-      fail-fast: false
-
-    env:
-      SOLUTION_FILE_PATH: src/Shell.sln
-      BUILD_CONFIGURATION: ${{matrix.configuration}}
-      BUILD_PLATFORM: ${{matrix.platform}}
-      BIN_PATH: D:\a\Shell\Shell\src\bin
-    runs-on: windows-latest
 
     steps:
-    - uses: actions/checkout@v4
-
-    - name: Add MSBuild to PATH
-      uses: microsoft/setup-msbuild@v2
-
-    - name: Restore NuGet packages
-      working-directory: ${{env.GITHUB_WORKSPACE}}
-      run: nuget restore ${{env.SOLUTION_FILE_PATH}}
-
-    - name: Build
-      working-directory: ${{env.GITHUB_WORKSPACE}}
-      run: msbuild /m /p:Configuration=${{env.BUILD_CONFIGURATION}} /p:Platform=${{env.BUILD_PLATFORM}} ${{env.SOLUTION_FILE_PATH}}
-
-    - name: Upload artifacts
-      uses: actions/upload-artifact@v4
-      with:
-        name: shell-${{matrix.platform}}
-        path: |
-          ${{env.BIN_PATH}}\*
-          !${{env.BIN_PATH}}\*.lib
-          !${{env.BIN_PATH}}\*.exp
-          !${{env.BIN_PATH}}\*.wixpdb
-          !${{env.BIN_PATH}}\ca.dll
-        if-no-files-found: warn
-        retention-days: 0
-        compression-level: 6
-        overwrite: false
-        include-hidden-files: false
+      # No submodules. src/lib/detours and src/lib/plutosvg are registered in
+      # .gitmodules but no project builds them: the DLL links the prebuilt
+      # detours-*.lib and plutosvg-*.lib committed under src/shared/Library, and
+      # nothing in any vcxproj, wixproj, props or targets file references either
+      # submodule or the vendored copies under src/3rdparty. Cloning them was
+      # ~4.5 MB of Detours samples per job, on every platform.
+      - uses: actions/checkout@v4
+
+      - name: Add MSBuild to PATH
+        uses: microsoft/setup-msbuild@v2
+
+      # One restore, and the same one build.ps1 runs locally. RestorePackagesConfig
+      # is what pulls VC-LTL, which lives in a packages.config; without it the
+      # VC-LTL.props imports silently no-op and the build links the static MSVC
+      # CRT instead of msvcrt.dll, producing a ~194 KB larger binary with a
+      # different heap. That divergence between CI and local builds was real
+      # until VC-LTL.props started erroring out on it.
+      - name: Restore packages
+        shell: pwsh
+        run: |
+          msbuild -t:Restore ${{ env.SOLUTION }} `
+            -p:RestorePackagesConfig=true `
+            -p:Configuration=${{ env.CONFIGURATION }} `
+            -p:Platform=${{ matrix.platform }}
+
+      # The compiler diagnostics are written to a file as well as the console.
+      # Workflow logs need a signed-in session to read, so on a failure in an
+      # architecture that cannot be built locally the actual error is otherwise
+      # unreachable; the artifact below is not.
+      - name: Build
+        shell: pwsh
+        run: |
+          msbuild -m ${{ env.SOLUTION }} `
+            -p:Configuration=${{ env.CONFIGURATION }} `
+            -p:Platform=${{ matrix.platform }} `
+            -p:RunTestsAfterBuild=false `
+            -fileLogger "-fileLoggerParameters:LogFile=build-${{ matrix.platform }}.log;Verbosity=normal" `
+            "-consoleLoggerParameters:Summary;ShowTimestamp"
+
+      - name: Upload build log
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: buildlog-${{ matrix.platform }}
+          path: build-${{ matrix.platform }}.log
+          if-no-files-found: warn
+
+      # Re-emitted as ::error:: workflow commands. Run logs and job summaries
+      # both need a signed-in session, but the annotations these produce are
+      # served by the public check-runs API, so the actual compiler diagnostic
+      # is reachable for an architecture that cannot be built locally.
+      - name: Surface errors
+        if: failure()
+        shell: pwsh
+        run: |
+          $log = "build-${{ matrix.platform }}.log"
+          if (-not (Test-Path $log)) { Write-Host "::error::no build log at $log"; exit 0 }
+
+          $errs = Select-String -Path $log -Pattern ': error |: fatal error ' |
+                  Select-Object -First 30 -ExpandProperty Line
+
+          if (-not $errs) {
+            # Failed without a recognisable compiler error: show the tail so the
+            # cause is not simply invisible.
+            $errs = Get-Content $log -Tail 30
+            Write-Host "::error::${{ matrix.platform }} build failed with no matching compiler error; tail follows"
+          }
+
+          foreach ($e in $errs) {
+            # Newlines and carriage returns have to be escaped or the annotation
+            # is truncated at the first one.
+            $clean = ($e -replace '%', '%25' -replace "`r", '' -replace "`n", '%0A').Trim()
+            if ($clean) { Write-Host "::error::${{ matrix.platform }}: $clean" }
+          }
+
+          "## ${{ matrix.platform }} build errors" | Out-File $env:GITHUB_STEP_SUMMARY -Append
+          '```'  | Out-File $env:GITHUB_STEP_SUMMARY -Append
+          $errs  | Out-File $env:GITHUB_STEP_SUMMARY -Append
+          '```'  | Out-File $env:GITHUB_STEP_SUMMARY -Append
+
+      # Run the suite explicitly on x64. RunTestsAfterBuild is disabled above
+      # so the executable is not run twice in CI. Cross-compiled builds cannot
+      # run on this host.
+      - name: Test
+        if: matrix.platform == 'x64'
+        shell: pwsh
+        run: |
+          & "src/bin/tests.exe"
+          if ($LASTEXITCODE -ne 0) { throw "tests failed with exit code $LASTEXITCODE" }
+
+      # shell.dll is mapped into every process that shows a context menu, so a
+      # COM call or a LoadLibrary added to DllMain deadlocks in hosts we never
+      # test by hand. x64 only, because it has to load the built DLL.
+      - name: Loader-lock check
+        if: matrix.platform == 'x64'
+        shell: cmd
+        run: |
+          call "%ProgramFiles%\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat" || call "%ProgramFiles%\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars64.bat"
+          cl /nologo /O2 /W3 tools\loadcheck\loadcheck.c ole32.lib /Fe:src\bin\loadcheck.exe || exit /b 1
+          src\bin\loadcheck.exe src\bin\shell.dll || exit /b 1
+          del src\bin\loadcheck.exe src\bin\loadcheck.obj 2>nul
+          exit /b 0
+
+      - name: Checksums
+        shell: pwsh
+        run: |
+          $files = Get-ChildItem src/bin -File |
+                   Where-Object { $_.Extension -in '.msi', '.dll', '.exe' -and $_.Name -ne 'tests.exe' }
+          $files | Get-FileHash -Algorithm SHA256 |
+            ForEach-Object { "{0}  {1}" -f $_.Hash.ToLower(), (Split-Path $_.Path -Leaf) } |
+            Tee-Object -FilePath src/bin/SHA256SUMS.txt
+
+      - name: Upload binaries
+        uses: actions/upload-artifact@v4
+        with:
+          name: shell-${{ matrix.platform }}
+          path: |
+            src/bin/**
+            !src/bin/*.lib
+            !src/bin/*.exp
+            !src/bin/*.ilk
+            !src/bin/*.pdb
+            !src/bin/*.wixpdb
+            !src/bin/ca.dll
+            !src/bin/tests.exe
+          if-no-files-found: error
+
+      # Kept separate so they are available for crash triage without being
+      # mistaken for something to ship.
+      - name: Upload symbols
+        uses: actions/upload-artifact@v4
+        with:
+          name: symbols-${{ matrix.platform }}
+          path: |
+            src/bin/*.pdb
+            !src/bin/tests.pdb
+          if-no-files-found: error
